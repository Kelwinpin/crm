generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ActionType {
  CREATE
  READ
  UPDATE
  DELETE

  @@map("action_type")
}

enum CustomerType {
  individual
  company
}

enum CompanySize {
  micro
  small
  medium
  large
}

enum CustomerStatus {
  active
  inactive
  prospect
  lead
}

model users {
  id               Int           @id @default(autoincrement())
  name             String        @db.VarChar(255)
  email            String        @unique @db.VarChar(255)
  password         String        @db.VarChar(255)
  cpf              String        @unique @db.VarChar(14)
  phoneNumber      String        @map("phone_number") @db.VarChar(20)
  deletedAt        DateTime?     @map("deleted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  permissions      permissions[]
  ownedCustomers   customers[]   @relation("CustomerOwner")
  createdCustomers customers[]   @relation("CustomerCreatedBy")
  updatedCustomers customers[]   @relation("CustomerUpdatedBy")

  @@index([email], map: "idx_users_email")
  @@index([cpf], map: "idx_users_cpf")
  @@index([deletedAt], map: "idx_users_deleted_at")
}

model dom_permissions {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(100)
  permissions permissions[]

  @@index([name], map: "idx_dom_permissions_name")
}

model permissions {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  domPermissionId Int             @map("dom_permission_id")
  action          ActionType
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domPermission   dom_permissions @relation(fields: [domPermissionId], references: [id], onDelete: Cascade)

  @@unique([userId, domPermissionId, action], map: "uq_user_domain_type")
  @@index([userId], map: "idx_permissions_user_id")
  @@index([domPermissionId], map: "idx_permissions_dom_id")
  @@index([action], map: "idx_permissions_type")
}

model dom_segments {
  id       Int        @id @default(autoincrement())
  name     String     @unique @db.VarChar(100)
  segments segments[]

  @@index([name], map: "idx_dom_segments_name")
}

model customers {
  id                 Int             @id @default(autoincrement())
  name               String          @db.VarChar(255)
  type               String?         @db.VarChar(255)
  cpfCnpj            String?         @unique @map("cpf_cnpj") @db.VarChar(20)
  email              String?         @db.VarChar(255)
  phone              String?         @db.VarChar(20)
  mobile             String?         @db.VarChar(20)
  website            String?         @db.VarChar(255)
  address            String?         @db.VarChar(255)
  addressNumber      String?         @map("address_number") @db.VarChar(20)
  addressComplement  String?         @map("address_complement") @db.VarChar(100)
  neighborhood       String?         @db.VarChar(100)
  city               String?         @db.VarChar(100)
  state              String?         @db.VarChar(2)
  zipCode            String?         @map("zip_code") @db.VarChar(9)
  country            String?         @default("Brasil") @db.VarChar(100)
  companySize        String?         @db.VarChar(255) @map("company_size")
  status             String?         @db.VarChar(255) @default("active")
  source             String?         @db.VarChar(50)
  ownerId            Int?            @map("owner_id")
  obs                String?         @db.Text
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")
  createdBy          Int?            @map("created_by")
  updatedBy          Int?            @map("updated_by")
  owner              users?          @relation("CustomerOwner", fields: [ownerId], references: [id])
  creator            users?          @relation("CustomerCreatedBy", fields: [createdBy], references: [id])
  updater            users?          @relation("CustomerUpdatedBy", fields: [updatedBy], references: [id])
  segments           segments[]

  @@index([name], map: "idx_customers_name")
  @@index([email], map: "idx_customers_email")
  @@index([status], map: "idx_customers_status")
  @@index([ownerId], map: "idx_customers_owner")
  @@index([type], map: "idx_customers_type")
}

model segments {
  id            Int           @id @default(autoincrement())
  customerId    Int           @map("customer_id")
  domSegmentId  Int           @map("dom_segment_id")
  customer      customers     @relation(fields: [customerId], references: [id])
  domSegment    dom_segments  @relation(fields: [domSegmentId], references: [id])

  @@index([customerId], map: "idx_segments_customer_id")
  @@index([domSegmentId], map: "idx_segments_dom_segment_id")
}